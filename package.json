  "scripts": { "test": "node --test test/*.test.js" },
  "engines": { "node": ">=20" },
  "keywords": ["github", "profile", "readme", "open-source", "contributions", "svg", "github-action"],
  "repository": { "type": "git", "url": "git+https://github.com/JROtto5/upstream-card.git" },
  "license": "MIT",
